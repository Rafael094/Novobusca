# =============================================================================
# IntelliINPI backend - PRODUCTION environment (Oracle Cloud VM)
#
# TEMPLATE ONLY. Copy it to `backend/.env` ON THE SERVER and fill in the real
# values. `backend/.env` is git-ignored and must never be committed.
#
#   ssh ubuntu@<VM_IP>
#   cd /opt/intelliinpi
#   cp backend/.env.prod.example backend/.env
#   nano backend/.env          # fill in every CHANGE_ME below
#   chmod 600 backend/.env
#
# Generate strong secrets with:
#   openssl rand -base64 48
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Anything other than "local" activates the strict secret validation in
# backend/app/config.py (JWT secrets >= 32 chars, distinct, real admin password).
ENVIRONMENT=production

# --- Database ----------------------------------------------------------------
# PostgreSQL already running on the VM host. From inside the container the host
# is reachable as `host.docker.internal` (see extra_hosts in docker-compose.prod.yml).
# Password URL-encoding: use %40 for @, %3A for :, %2F for /.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@host.docker.internal:5432/intelliinpi_app

# --- DeepSeek AI ("Analises IA") ---------------------------------------------
# Optional: leave empty to keep the feature disabled (endpoint returns HTTP 503).
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TIMEOUT_SECONDS=60

# --- Security (REQUIRED in production) ---------------------------------------
# MUST be >= 32 characters and DIFFERENT from each other, or the app refuses
# to boot. Generate each one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_characters_long__run_openssl_rand
JWT_REFRESH_SECRET=CHANGE_ME_different_from_JWT_SECRET__at_least_32_chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# --- Master admin ------------------------------------------------------------
# Real domain (TLDs like .local are rejected) and a password different from the
# shipped example, otherwise the app refuses to boot.
MASTER_ADMIN_EMAIL=master@CHANGE_ME.com.br
MASTER_ADMIN_PASSWORD=CHANGE_ME_strong_password
MASTER_ADMIN_NAME=Master Admin

# --- CORS --------------------------------------------------------------------
# Exact origin of the Vercel frontend (no trailing slash). Multiple origins:
# comma-separated.
CORS_ORIGINS=https://CHANGE_ME.vercel.app

# --- Storage / paths ---------------------------------------------------------
# Private NIT document storage. Matches the api_documents volume mount in
# docker-compose.prod.yml so uploads survive container recreation.
DOCUMENT_STORAGE_DIR=/app/var/documents
DOCUMENT_MAX_SIZE_MB=25
STORAGE_BACKEND=local
STORAGE_BUCKET=

# Ingested INPI datasets (matches the api_data volume).
DATA_DIR=/app/data

# --- External data source ----------------------------------------------------
INPI_BASE_URL=https://dadosabertos.inpi.gov.br

# --- Misc --------------------------------------------------------------------
DEFAULT_TENANT_NAME=Matriz

# --- Índices de busca (opcional) ---------------------------------------------
# Todo deploy roda `python -m app.db_indexes` antes do seed: reconcilia os
# índices das tabelas do INPI (idempotente, cria só o que falta). Nada precisa
# ser configurado; as variáveis abaixo existem para casos específicos.
#
#   INDEX_SKIP=1                    pula a reconciliação neste deploy
#   INDEX_BUILD_TIMEOUT_SECONDS=0   limite em segundos por índice (0 = sem limite).
#                                   Útil para não segurar a subida da API quando
#                                   um índice GIN trigram precisa ser reconstruído
#                                   do zero em tabela cheia (o log avisa e o índice
#                                   é retomado no próximo deploy).
#   INDEX_MAINTENANCE_WORK_MEM=256MB memória por build de índice (aumente se a VM
#                                   tiver RAM sobrando: builds mais rápidos).
#INDEX_SKIP=0
#INDEX_BUILD_TIMEOUT_SECONDS=0
#INDEX_MAINTENANCE_WORK_MEM=256MB

# --- Worker de petições do pePI (opcional) -----------------------------------
# O serviço `peticoes` do docker-compose.prod.yml lê a página de detalhe do pePI
# e grava as petições (documentos GRU) em `marcas_peticoes`. Estes knobs ajustam
# o ritmo; os valores padrão são conservadores (não martelam a fonte legada).
#
#   INPI_PEPI_CONCURRENCY   requisições simultâneas (padrão 4)
#   INPI_PEPI_DELAY         pausa por requisição, em segundos (padrão 0.25)
#   INPI_PEPI_BASE_URL      base do pePI (padrão https://busca.inpi.gov.br/pePI)
#   INPI_VERIFY_SSL=false   desativa a verificação TLS (só se o pePI quebrar)
#INPI_PEPI_CONCURRENCY=2
#INPI_PEPI_DELAY=0.25

# --- Worker da RPI (semanal) --------------------------------------------------
# O serviço `rpi` do docker-compose.prod.yml descobre a edição mais recente da
# Revista (publicada às terças), baixa o ZIP de /txt/ e grava os despachos novos
# em `marcas_despachos`/`patentes_despachos` (estado em `inpi_rpi`). O laço e a
# janela de busca são flags do `command` do compose; aqui só a base.
#
#   INPI_RPI_BASE_URL       base do portal das Revistas
#                           (padrão https://revistas.inpi.gov.br)
#INPI_RPI_BASE_URL=https://revistas.inpi.gov.br
#
# Imagens/logotipos das marcas (referenciadas por <nome-imagem> no XML da RPI).
# O worker baixa após gravar os despachos; `ERROR` é retomado na próxima rodada.
#
#   INPI_BUSCA_IMAGES_BASE_URL  busca pública de imagens
#                               (padrão https://busca.inpi.gov.br/marca/imagem)
#   INPI_RPI_IMAGE_CONCURRENCY  downloads simultâneos (padrão 6)
#   INPI_RPI_IMAGE_DELAY        pausa por imagem, em segundos (padrão 0.05)
#   INPI_RPI_IMAGE_RETRIES      tentativas por URL antes do fallback (padrão 3)
#   INPI_RPI_IMAGE_TIMEOUT      timeout de cada requisição (padrão 30 s)
#   INPI_RPI_IMAGE_MAX_BYTES    tamanho máximo aceito (padrão 15 MiB)
#INPI_BUSCA_IMAGES_BASE_URL=https://busca.inpi.gov.br/marca/imagem
#INPI_RPI_IMAGE_CONCURRENCY=6
#INPI_RPI_IMAGE_DELAY=0.05
#INPI_RPI_IMAGE_RETRIES=3
#INPI_RPI_IMAGE_TIMEOUT=30
#INPI_RPI_IMAGE_MAX_BYTES=15728640

# --- Logotipos das marcas (imagens do pePI) -----------------------------------
# As imagens NÃO vêm nos dados abertos e não são restauradas junto com um dump do
# banco: `marcas_logos` guarda o metadado e o JPEG vive em `data/raw/marcas/logos`
# (volume `api_data`). `tem_logo` só é true quando o arquivo existe em disco.
#
#   LOGO_FETCH_ENABLED=true  o detalhe de uma marca Mista/Figurativa busca a
#                            imagem no pePI na hora, grava no volume e devolve
#                            embutida no campo `logo`. Útil para povoar uma VM
#                            nova sem transferir arquivo; deixe `false` (padrão)
#                            no dia a dia para nenhuma leitura esperar o INPI.
#   LOGO_HTTP_TIMEOUT_SECONDS  timeout da requisição ao pePI (padrão 120 s — só
#                            use alto no worker; com o fetch ligado, 10–15 s)
#   LOGO_HTTP_RETRIES        tentativas antes de registrar ERROR (padrão 2)
#LOGO_FETCH_ENABLED=false
#LOGO_HTTP_TIMEOUT_SECONDS=15
#LOGO_HTTP_RETRIES=1
