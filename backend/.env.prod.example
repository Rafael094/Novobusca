# =============================================================================
# IntelliINPI backend - PRODUCTION environment (Oracle Cloud VM)
#
# TEMPLATE ONLY. Copy it to `backend/.env` ON THE SERVER and fill in the real
# values. `backend/.env` is git-ignored and must never be committed.
#
#   ssh ubuntu@<VM_IP>
#   cd /opt/intelliinpi
#   cp backend/.env.prod.example backend/.env
#   nano backend/.env          # fill in every CHANGE_ME below
#   chmod 600 backend/.env
#
# Generate strong secrets with:
#   openssl rand -base64 48
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Anything other than "local" activates the strict secret validation in
# backend/app/config.py (JWT secrets >= 32 chars, distinct, real admin password).
ENVIRONMENT=production

# --- Database ----------------------------------------------------------------
# PostgreSQL already running on the VM host. From inside the container the host
# is reachable as `host.docker.internal` (see extra_hosts in docker-compose.prod.yml).
# Password URL-encoding: use %40 for @, %3A for :, %2F for /.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@host.docker.internal:5432/intelliinpi_app

# --- DeepSeek AI ("Analises IA") ---------------------------------------------
# Optional: leave empty to keep the feature disabled (endpoint returns HTTP 503).
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TIMEOUT_SECONDS=60

# --- Security (REQUIRED in production) ---------------------------------------
# MUST be >= 32 characters and DIFFERENT from each other, or the app refuses
# to boot. Generate each one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_characters_long__run_openssl_rand
JWT_REFRESH_SECRET=CHANGE_ME_different_from_JWT_SECRET__at_least_32_chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# --- Master admin ------------------------------------------------------------
# Real domain (TLDs like .local are rejected) and a password different from the
# shipped example, otherwise the app refuses to boot.
MASTER_ADMIN_EMAIL=master@CHANGE_ME.com.br
MASTER_ADMIN_PASSWORD=CHANGE_ME_strong_password
MASTER_ADMIN_NAME=Master Admin

# --- CORS --------------------------------------------------------------------
# Exact origin of the Vercel frontend (no trailing slash). Multiple origins:
# comma-separated.
CORS_ORIGINS=https://CHANGE_ME.vercel.app

# --- Storage / paths ---------------------------------------------------------
# Private NIT document storage. Matches the api_documents volume mount in
# docker-compose.prod.yml so uploads survive container recreation.
DOCUMENT_STORAGE_DIR=/app/var/documents
DOCUMENT_MAX_SIZE_MB=25
STORAGE_BACKEND=local
STORAGE_BUCKET=

# Ingested INPI datasets (matches the api_data volume).
DATA_DIR=/app/data

# --- External data source ----------------------------------------------------
INPI_BASE_URL=https://dadosabertos.inpi.gov.br

# --- Misc --------------------------------------------------------------------
DEFAULT_TENANT_NAME=Matriz
