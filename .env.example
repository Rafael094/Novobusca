# =============================================================================
# IntelliINPI - Environment configuration example
# Copy this file to .env and adjust the values. NEVER commit the real .env file.
# =============================================================================

# --- Environment ------------------------------------------------------------
# Selects startup strictness. "local" (default) tolerates the development
# defaults below and is the only mode that does. Any other value (staging,
# production, ...) REFUSES to start while JWT_SECRET / JWT_REFRESH_SECRET /
# MASTER_ADMIN_PASSWORD still hold their shipped default values, if the two JWT
# secrets are equal, or if a JWT secret is shorter than 32 characters.
ENVIRONMENT=local

# --- Database ---------------------------------------------------------------
# Native local PostgreSQL (default for this project).
# This project uses a DEDICATED database (intelliinpi_app) so it never mixes
# with any other schema on a shared PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intelliinpi_app
# If you use the provided docker-compose stack instead, use:
# DATABASE_URL=postgresql+psycopg://intelliinpi:intelliinpi@localhost:5433/intelliinpi_app

# --- Security ---------------------------------------------------------------
JWT_SECRET=change-me-in-production-please-use-a-long-random-string-32chars+
JWT_REFRESH_SECRET=change-me-too-in-production-please-use-a-long-random-string-32chars+
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# --- Master admin (created on first startup if not present) -----------------
# NOTE: use a real, valid domain — email-validator rejects reserved TLDs (.local).
MASTER_ADMIN_EMAIL=master@intelliinpi.com.br
MASTER_ADMIN_PASSWORD=ChangeMe_MasterAdmin_123!
MASTER_ADMIN_NAME=Master Admin

# --- INPI -------------------------------------------------------------------
INPI_BASE_URL=https://dadosabertos.inpi.gov.br
DATA_DIR=./data

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Login rate limiting ----------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Default tenant ---------------------------------------------------------
# Tenant created by the seed/migration for data isolation.
DEFAULT_TENANT_NAME=Matriz

# --- DeepSeek (IA) ----------------------------------------------------------
# Real DeepSeek integration for the trademark risk analysis ("Análises IA").
# Leave DEEPSEEK_API_KEY empty to keep the feature gracefully disabled
# (the endpoint returns HTTP 503 instead of fabricating an analysis).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TIMEOUT_SECONDS=60

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
